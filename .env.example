# Copie para .env e preencha. O .env NÃO vai para o Git.

# ---------- Front-end (Vite) ----------
# Variáveis expostas ao navegador precisam começar com VITE_
VITE_STORE_NAME=Lumen Store
# VITE_API_URL=http://localhost:3000/api

# ---------- Banco de dados (docker-compose.yml) ----------
POSTGRES_DB=lumen_store
POSTGRES_USER=lumen
POSTGRES_PASSWORD=lumen123
DATABASE_URL=postgresql://lumen:lumen123@localhost:5432/lumen_store

